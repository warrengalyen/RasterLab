<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.0"/>
  
  <!-- Main Layers Panel -->
  <object class="GtkBox" id="layers_panel">
    <property name="visible">True</property>
    <property name="can_focus">False</property>
    <property name="orientation">vertical</property>
    <property name="spacing">0</property>
    
    <!-- Scrolled Window for Tree View -->
    <child>
      <object class="GtkScrolledWindow" id="layers_scroll">
        <property name="visible">True</property>
        <property name="can_focus">True</property>
        <property name="hscrollbar_policy">automatic</property>
        <property name="vscrollbar_policy">automatic</property>
        <child>
          <!-- Tree View will be added by code -->
          <placeholder/>
        </child>
      </object>
      <packing>
        <property name="expand">True</property>
        <property name="fill">True</property>
        <property name="position">0</property>
      </packing>
    </child>
    
    <!-- Control Buttons -->
    <child>
      <object class="GtkBox" id="layers_controls">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="orientation">horizontal</property>
        <property name="spacing">5</property>
        <property name="margin_top">5</property>
        <property name="margin_bottom">5</property>
        <property name="margin_start">5</property>
        <property name="margin_end">5</property>
        
        <!-- New Layer Button -->
        <child>
          <object class="GtkButton" id="btn_new_layer">
            <property name="label">New</property>
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="receives_default">True</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">0</property>
          </packing>
        </child>
        
        <!-- Delete Layer Button -->
        <child>
          <object class="GtkButton" id="btn_delete_layer">
            <property name="label">Delete</property>
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="receives_default">True</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">1</property>
          </packing>
        </child>
        
        <!-- Duplicate Layer Button -->
        <child>
          <object class="GtkButton" id="btn_duplicate_layer">
            <property name="label">Duplicate</property>
            <property name="visible">True</property>
            <property name="can_focus">True</property>
            <property name="receives_default">True</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">2</property>
          </packing>
        </child>
      </object>
      <packing>
        <property name="expand">False</property>
        <property name="fill">True</property>
        <property name="position">1</property>
      </packing>
    </child>
  </object>
</interface>
