<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.0"/>
  
  <!-- File Menu -->
  <object class="GtkMenu" id="file_menu">
    <property name="visible">True</property>
    <property name="can_focus">False</property>
    
    <!-- File > Open -->
    <child>
      <object class="GtkMenuItem" id="file_menu_open">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="label" translatable="yes">_Open</property>
        <property name="use_underline">True</property>
        <accelerator key="o" signal="activate" modifiers="GDK_CONTROL_MASK"/>
      </object>
    </child>
    
    <!-- File > Save As -->
    <child>
      <object class="GtkMenuItem" id="file_menu_save_as">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="label" translatable="yes">_Save As</property>
        <property name="use_underline">True</property>
        <accelerator key="s" signal="activate" modifiers="GDK_CONTROL_MASK"/>
      </object>
    </child>
    
    <!-- Separator -->
    <child>
      <object class="GtkSeparatorMenuItem" id="file_separator1">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
      </object>
    </child>
    
    <!-- File > Close -->
    <child>
      <object class="GtkMenuItem" id="file_menu_close">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="label" translatable="yes">_Close</property>
        <property name="use_underline">True</property>
      </object>
    </child>
    
    <!-- Separator -->
    <child>
      <object class="GtkSeparatorMenuItem" id="file_separator2">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
      </object>
    </child>
    
    <!-- File > Exit -->
    <child>
      <object class="GtkMenuItem" id="file_menu_exit">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="label" translatable="yes">E_xit</property>
        <property name="use_underline">True</property>
        <accelerator key="q" signal="activate" modifiers="GDK_CONTROL_MASK"/>
      </object>
    </child>
  </object>
  
  <!-- Edit Menu -->
  <object class="GtkMenu" id="edit_menu">
    <property name="visible">True</property>
    <property name="can_focus">False</property>
    
    <!-- Edit > Undo -->
    <child>
      <object class="GtkMenuItem" id="edit_menu_undo">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="label" translatable="yes">_Undo</property>
        <property name="use_underline">True</property>
        <property name="sensitive">False</property>
        <accelerator key="z" signal="activate" modifiers="GDK_CONTROL_MASK"/>
      </object>
    </child>
    
    <!-- Edit > Redo -->
    <child>
      <object class="GtkMenuItem" id="edit_menu_redo">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="label" translatable="yes">_Redo</property>
        <property name="use_underline">True</property>
        <property name="sensitive">False</property>
        <accelerator key="y" signal="activate" modifiers="GDK_CONTROL_MASK"/>
      </object>
    </child>
  </object>
  
  <!-- View Menu -->
  <object class="GtkMenu" id="view_menu">
    <property name="visible">True</property>
    <property name="can_focus">False</property>
    
    <!-- View > Zoom In -->
    <child>
      <object class="GtkMenuItem" id="view_menu_zoom_in">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="label" translatable="yes">Zoom _In</property>
        <property name="use_underline">True</property>
        <accelerator key="plus" signal="activate" modifiers="GDK_CONTROL_MASK"/>
        <accelerator key="equal" signal="activate" modifiers="GDK_CONTROL_MASK"/>
      </object>
    </child>
    
    <!-- View > Zoom Out -->
    <child>
      <object class="GtkMenuItem" id="view_menu_zoom_out">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="label" translatable="yes">Zoom _Out</property>
        <property name="use_underline">True</property>
        <accelerator key="minus" signal="activate" modifiers="GDK_CONTROL_MASK"/>
      </object>
    </child>
    
    <!-- View > Zoom Reset -->
    <child>
      <object class="GtkMenuItem" id="view_menu_zoom_reset">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="label" translatable="yes">_Reset Zoom</property>
        <property name="use_underline">True</property>
        <accelerator key="0" signal="activate" modifiers="GDK_CONTROL_MASK"/>
      </object>
    </child>
    
    <!-- View > Fit to Window -->
    <child>
      <object class="GtkMenuItem" id="view_menu_zoom_fit">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="label" translatable="yes">_Fit to Window</property>
        <property name="use_underline">True</property>
        <accelerator key="1" signal="activate" modifiers="GDK_CONTROL_MASK"/>
      </object>
    </child>
  </object>
  
  <!-- Layer Menu -->
  <object class="GtkMenu" id="layer_menu">
    <property name="visible">True</property>
    <property name="can_focus">False</property>
    
    <!-- Layer > New Layer -->
    <child>
      <object class="GtkMenuItem" id="layer_menu_new">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="label" translatable="yes">_New Layer</property>
        <property name="use_underline">True</property>
      </object>
    </child>
    
    <!-- Layer > Duplicate Layer -->
    <child>
      <object class="GtkMenuItem" id="layer_menu_duplicate">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="label" translatable="yes">_Duplicate Layer</property>
        <property name="use_underline">True</property>
      </object>
    </child>
    
    <!-- Separator -->
    <child>
      <object class="GtkSeparatorMenuItem" id="layer_separator">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
      </object>
    </child>
    
    <!-- Layer > Delete Layer -->
    <child>
      <object class="GtkMenuItem" id="layer_menu_delete">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="label" translatable="yes">_Delete Layer</property>
        <property name="use_underline">True</property>
      </object>
    </child>
  </object>
  
  <!-- Main Window -->
  <object class="GtkWindow" id="main_window">
    <property name="can_focus">False</property>
    <property name="title">Image Editor</property>
    <property name="default_width">1600</property>
    <property name="default_height">1000</property>
    <property name="window_position">center</property>
    <property name="icon_name">image-editor</property>
    
    <child>
      <!-- Main Vertical Box -->
      <object class="GtkBox" id="main_vbox">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">0</property>
        
        <!-- Menu Bar -->
        <child>
          <object class="GtkMenuBar" id="menu_bar">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            
            <!-- File Menu -->
            <child>
              <object class="GtkMenuItem" id="file_menu_item">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="label" translatable="yes">_File</property>
                <property name="use_underline">True</property>
              </object>
            </child>
            
            <!-- Edit Menu -->
            <child>
              <object class="GtkMenuItem" id="edit_menu_item">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="label" translatable="yes">_Edit</property>
                <property name="use_underline">True</property>
              </object>
            </child>
            
            <!-- View Menu -->
            <child>
              <object class="GtkMenuItem" id="view_menu_item">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="label" translatable="yes">_View</property>
                <property name="use_underline">True</property>
              </object>
            </child>
            
            <!-- Layer Menu -->
            <child>
              <object class="GtkMenuItem" id="layer_menu_item">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="label" translatable="yes">_Layer</property>
                <property name="use_underline">True</property>
              </object>
            </child>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">0</property>
          </packing>
        </child>
        
        <!-- Tool Options Panel Container (placeholder for programmatically created panel) -->
        <child>
          <object class="GtkBox" id="tool_options_container">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="orientation">vertical</property>
            <property name="spacing">0</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">1</property>
          </packing>
        </child>
        
        <!-- Main Horizontal Box -->
        <child>
          <object class="GtkBox" id="main_hbox">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">0</property>
            
            <!-- Tools Panel Container (placeholder for programmatically created panel) -->
            <child>
              <object class="GtkBox" id="tools_panel_container">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="orientation">vertical</property>
                <property name="spacing">0</property>
              </object>
              <packing>
                <property name="expand">False</property>
                <property name="fill">True</property>
                <property name="position">0</property>
              </packing>
            </child>
            
            <!-- Center-Right Horizontal Paned -->
            <child>
              <object class="GtkPaned" id="center_right_hpaned">
                <property name="visible">True</property>
                <property name="can_focus">False</property>
                <property name="orientation">horizontal</property>
                
                <!-- Notebook for document tabs -->
                <child>
                  <object class="GtkNotebook" id="notebook">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="scrollable">True</property>
                    <property name="tab_pos">top</property>
                  </object>
                  <packing>
                    <property name="resize">True</property>
                    <property name="shrink">True</property>
                  </packing>
                </child>
                
                <!-- Layers Panel Container (placeholder for programmatically created panel) -->
                <child>
                  <object class="GtkBox" id="layers_panel_container">
                    <property name="visible">True</property>
                    <property name="can_focus">False</property>
                    <property name="orientation">vertical</property>
                    <property name="spacing">0</property>
                    <property name="width_request">350</property>
                  </object>
                  <packing>
                    <property name="resize">False</property>
                    <property name="shrink">True</property>
                  </packing>
                </child>
              </object>
              <packing>
                <property name="expand">True</property>
                <property name="fill">True</property>
                <property name="position">1</property>
              </packing>
            </child>
          </object>
          <packing>
            <property name="expand">True</property>
            <property name="fill">True</property>
            <property name="position">2</property>
          </packing>
        </child>
        
        <!-- Status Bar -->
        <child>
          <object class="GtkStatusbar" id="status_bar">
            <property name="visible">True</property>
            <property name="can_focus">False</property>
          </object>
          <packing>
            <property name="expand">False</property>
            <property name="fill">True</property>
            <property name="position">3</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
</interface>
